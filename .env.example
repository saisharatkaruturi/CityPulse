# Copy to .env and adjust. Never commit a real .env. All values below are placeholders.

# development | test | production. Production enforces a strong JWT secret, DEBUG=false,
# explicit CORS origins, and disables /docs, demo seeding and demo reset.
ENVIRONMENT=development
DEBUG=false

# SQLite for local development (default). PostgreSQL also works:
#   uv sync --extra postgres
#   DATABASE_URL=postgresql+psycopg://ycys_app:<password>@localhost:5432/ycys
DATABASE_URL=sqlite:///./var/ycys.db

# Required in production: random string, at least 32 characters (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`).
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=ycys-backend
JWT_AUDIENCE=ycys-clients
ACCESS_TOKEN_TTL_MINUTES=60
ALLOW_SELF_REGISTRATION=true

# Comma-separated list of allowed browser origins. Empty = CORS disabled.
CORS_ORIGINS=

# Limits
MAX_REQUEST_BYTES=1000000
MAX_UPLOAD_BYTES=5000000
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
RATE_LIMIT_ENABLED=true

# Private upload storage (local filesystem)
MEDIA_ROOT=./var/media
ORPHAN_MEDIA_MAX_AGE_HOURS=24

# Workflow policy (illustrative defaults, not official municipal policy)
REOPEN_WINDOW_DAYS=14
AUTO_CLOSE_RESOLVED_AFTER_DAYS=7
REQUIRE_RESOLUTION_NOTES=true
SLA_REMINDER_LEAD_FRACTION=0.2
ESCALATION_MAX_LEVEL=2

# Duplicate detection / public map
DUPLICATE_RADIUS_M=150
DUPLICATE_WINDOW_DAYS=30
DUPLICATE_MAX_RESULTS=10
NEARBY_MAX_RADIUS_M=2000
PUBLIC_COORDINATE_DECIMALS=3

# Optional providers. Only "disabled" or "mock" (SIMULATED, nothing leaves the process) exist today.
# keyword | mock | disabled
AI_PROVIDER=keyword
AI_CONFIDENCE_THRESHOLD=0.6
# disabled | mock
EMAIL_PROVIDER=disabled
# disabled | mock
SMS_PROVIDER=disabled
# disabled | mock
MUNICIPAL_INTEGRATION=disabled
# disabled | mock
GEOCODING_PROVIDER=disabled
EXTERNAL_CALL_TIMEOUT_SECONDS=5

# Background worker
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BASE_BACKOFF_SECONDS=30
WORKER_INTERVAL_SECONDS=30

# Development-only password for seeded demo accounts. Seeding refuses to run in production.
DEMO_PASSWORD=demo-password-123
# Demo mode shows the DEMO badge and offers the seeded accounts on the sign-in page (GET /api/meta).
# Leave unset for the default: on outside production, off in production. Set true only for a public demo.
# DEMO_MODE=true
